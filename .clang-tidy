Checks: >
  -*,
  bugprone-*,
  concurrency-*,
  performance-*,
  modernize-*,
  cppcoreguidelines-*,
  readability-container-size-empty,
  readability-make-member-function-const,
  readability-redundant-*,
  readability-simplify-boolean-expr,
  -modernize-use-trailing-return-type,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -performance-enum-size

CheckOptions:
  # std::stop_token is a cheap handle; the standard library passes it by value.
  performance-unnecessary-value-param.AllowedTypes: 'std::stop_token'

# Only our own headers (GoogleTest/Benchmark also have src/ folders).
HeaderFilterRegex: '.*/src/[A-Z][A-Za-z]*\.h$'
